---
const download = 'https://github.com/enegalan/MacPhoneMirror/releases/latest';
const github = 'https://github.com/enegalan/MacPhoneMirror';
---

<section class="section cta">
  <div class="wrap cta-inner">
    <span class="cta-glow" aria-hidden="true"></span>
    <h2>Ready to try?</h2>
    <p>Download MacPhoneMirror and start mirroring in seconds.</p>
    <div class="actions">
      <a class="btn btn-primary" href={download}>Download for Mac</a>
      <a class="btn btn-ghost" href={github} target="_blank" rel="noopener noreferrer">Star on GitHub</a>
    </div>
    <p class="note">Requires macOS 14.0 or later</p>
  </div>
</section>

<style>
  .cta {
    padding-bottom: 5rem;
  }

  .cta-inner {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 3.5rem 1.5rem;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: rgba(255, 252, 247, 0.55);
    backdrop-filter: blur(10px);
  }

  .cta-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    left: 50%;
    top: -40%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(3, 177, 239, 0.28), rgba(127, 88, 255, 0.18), transparent 70%);
    filter: blur(28px);
    pointer-events: none;
  }

  h2 {
    position: relative;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  p,
  .actions,
  .note {
    position: relative;
  }

  p {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
