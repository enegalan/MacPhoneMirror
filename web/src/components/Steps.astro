---
const steps = [
  {
    n: '01',
    title: 'Launch MacPhoneMirror',
    body: 'Open the app on your Mac and enable the AirPlay service in the Service tab.',
  },
  {
    n: '02',
    title: 'Connect from iPhone',
    body: 'Open Control Center, tap Screen Mirroring, and select your Mac.',
  },
  {
    n: '03',
    title: 'Tap & drag',
    body: 'Pair Bluetooth HID and enable AssistiveTouch if you want pointer taps and drags from mouse or trackpad.',
  },
];
---

<section class="section" id="how-it-works">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps. That's it.</h2>
      <p>Same local Wi‑Fi (or USB). Your Mac becomes the AirPlay target.</p>
    </div>
    <ol class="steps">
      {
        steps.map((step) => (
          <li>
            <span class="n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  li {
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }

  .n {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.15rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
    line-height: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, rgba(3, 177, 239, 0.22), transparent 65%),
      rgba(0, 163, 255, 0.1);
    border: 1px solid rgba(0, 163, 255, 0.18);
  }

  @media (min-width: 800px) {
    li:not(:last-child) {
      position: relative;
    }

    li:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 1.25rem;
      left: calc(2.6rem + 0.75rem);
      right: -1.25rem;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgba(3, 177, 239, 0.45),
        rgba(127, 88, 255, 0.25),
        transparent
      );
      pointer-events: none;
    }
  }

  h3 {
    font-size: 1.2rem;
  }

  p {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
</style>
