---
const github = 'https://github.com/enegalan/MacPhoneMirror';
const security = 'https://github.com/enegalan/MacPhoneMirror/blob/main/SECURITY.md';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <a class="brand" href="#top">
      <img src="/app-icon.png" alt="" width="24" height="24" />
      <span>MacPhoneMirror</span>
    </a>
    <nav aria-label="Footer">
      <a href="#features">Features</a>
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={security} target="_blank" rel="noopener noreferrer">Security</a>
      <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">MIT License</a>
    </nav>
    <p>© {year} MacPhoneMirror. Free and open source.</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand img {
    width: 24px;
    height: 24px;
    border-radius: 6px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.35rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 500;
  }

  nav a:hover {
    color: var(--ink);
  }

  p {
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
