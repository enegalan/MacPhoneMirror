---
const download = 'https://github.com/enegalan/MacPhoneMirror/releases/latest';
---

<section class="hero" id="top">
  <div class="wrap hero-copy">
    <img class="brand-mark" src="/logo-brand.png" alt="MacPhoneMirror" width="440" height="100" />
    <h1>
      Mirror your iPhone on Mac —
      <span class="text-gradient"> and tap it with your mouse.</span>
    </h1>
    <p class="lede">
      Native AirPlay receiver with AssistiveTouch pointer control,
      and one floating screen per phone. No jailbreak. No phone app.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={download}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 2v8m0 0L5 7m3 3 3-3M3 12.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Download for Mac
      </a>
      <a class="btn btn-ghost" href="#how-it-works">
        Learn more
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3v9m0 0 3.5-3.5M8 12 4.5 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="hero-stage">
    <div class="stage-glow" aria-hidden="true"></div>
    <img
      class="hero-shot"
      src="/intro/macbook.webp"
      alt="MacBook showing MacPhoneMirror with an iPhone screen floating on the desktop"
      width="2940"
      height="1772"
      decoding="async"
      fetchpriority="high"
    />
    <img
      class="phone-shot"
      src="/intro/iphone.webp"
      alt=""
      width="1339"
      height="2716"
      decoding="async"
      aria-hidden="true"
    />
  </div>
</section>

<style>
  .hero {
    padding-top: 3.25rem;
  }

  .hero-copy {
    text-align: center;
    padding-bottom: 2.4rem;
    animation: rise-in 0.75s ease both;
  }

  .brand-mark {
    width: min(100%, 400px);
    margin: 0 auto 1.6rem;
    filter: drop-shadow(0 12px 40px rgba(0, 194, 255, 0.18));
  }

  h1 {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(2.2rem, 5.2vw, 3.55rem);
  }

  .lede {
    max-width: 36rem;
    margin: 1.2rem auto 0;
    color: var(--ink-soft);
    font-size: 1.12rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 1.9rem;
  }

  .hero-stage {
    position: relative;
    width: min(100%, 1180px);
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    padding: 0 0.75rem 0.5rem;
    animation: rise-in 0.95s ease 0.1s both;
  }

  .stage-glow {
    position: absolute;
    left: 50%;
    bottom: 10%;
    width: min(78%, 720px);
    height: 42%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(0, 194, 255, 0.22), transparent 72%);
    filter: blur(28px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-shot {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    width: auto;
    max-width: min(100%, 850px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 28px 70px rgba(0, 0, 0, 0.45));
  }

  .phone-shot {
    position: relative;
    z-index: 3;
    flex: 0 0 auto;
    width: min(22vw, 150px);
    height: auto;
    margin-bottom: 1.8%;
    margin-left: -8.5%;
    filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.5));
  }

  @media (max-width: 760px) {
    .phone-shot {
      display: none;
    }

    .hero-shot {
      max-width: 100%;
    }
  }

  @media (min-width: 900px) {
    .phone-shot {
      width: 170px;
    }
  }

  @media (min-width: 1100px) {
    .phone-shot {
      width: 190px;
    }
  }
</style>
