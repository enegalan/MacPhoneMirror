---
---

<div class="ambient" aria-hidden="true">
  <span class="orb orb-1"></span>
  <span class="orb orb-2"></span>
  <span class="orb orb-3"></span>
  <span class="orb orb-4"></span>
  <span class="orb orb-5"></span>
  <span class="orb orb-6"></span>
  <span class="orb orb-7"></span>
  <span class="orb orb-8"></span>
</div>

<style>
  .ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    will-change: transform;
    animation: orb-drift 18s ease-in-out infinite;
  }

  /* Hero */
  .orb-1 {
    width: min(58vw, 460px);
    height: min(58vw, 460px);
    top: 2%;
    left: -8%;
    background: rgba(3, 177, 239, 0.42);
    animation-duration: 22s;
  }

  .orb-2 {
    width: min(48vw, 380px);
    height: min(48vw, 380px);
    top: 8%;
    right: -10%;
    background: rgba(127, 88, 255, 0.36);
    animation-duration: 26s;
    animation-delay: -4s;
  }

  /* Features */
  .orb-3 {
    width: min(44vw, 340px);
    height: min(44vw, 340px);
    top: 22%;
    left: 55%;
    background: rgba(58, 97, 242, 0.32);
    animation-duration: 20s;
    animation-delay: -8s;
  }

  /* Steps */
  .orb-4 {
    width: min(50vw, 400px);
    height: min(50vw, 400px);
    top: 36%;
    left: -12%;
    background: rgba(255, 160, 110, 0.32);
    animation-duration: 24s;
    animation-delay: -2s;
  }

  /* Gatekeeper */
  .orb-5 {
    width: min(42vw, 320px);
    height: min(42vw, 320px);
    top: 50%;
    right: -8%;
    background: rgba(175, 82, 255, 0.3);
    animation-duration: 28s;
    animation-delay: -10s;
  }

  /* FAQ */
  .orb-6 {
    width: min(46vw, 360px);
    height: min(46vw, 360px);
    top: 64%;
    left: 8%;
    background: rgba(3, 177, 239, 0.34);
    animation-duration: 21s;
    animation-delay: -6s;
  }

  /* Closing CTA */
  .orb-7 {
    width: min(52vw, 420px);
    height: min(52vw, 420px);
    top: 78%;
    right: 5%;
    background: rgba(127, 88, 255, 0.34);
    animation-duration: 25s;
    animation-delay: -12s;
  }

  /* Footer */
  .orb-8 {
    width: min(40vw, 300px);
    height: min(40vw, 300px);
    top: 90%;
    left: 35%;
    background: rgba(58, 97, 242, 0.26);
    animation-duration: 23s;
    animation-delay: -3s;
  }

  @keyframes orb-drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(18px, -22px) scale(1.06);
    }
    66% {
      transform: translate(-14px, 12px) scale(0.96);
    }
  }

  @media (max-width: 720px) {
    .orb {
      filter: blur(56px);
    }

    .orb-3,
    .orb-5,
    .orb-8 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      animation: none;
    }
  }
</style>
